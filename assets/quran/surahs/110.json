    "verses": [
      {
        "surahNumber": 110,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ",
        "juzNumber": 30,
        "pageNumber": 603
      },
      {
        "surahNumber": 110,
        "ayahNumber": 2,
        "uthmaniText": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا",
        "juzNumber": 30,
        "pageNumber": 603
      },
      {
        "surahNumber": 110,
        "ayahNumber": 3,
        "uthmaniText": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا",
        "juzNumber": 30,
        "pageNumber": 603
      }
    ]
  }
