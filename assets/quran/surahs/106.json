    "verses": [
      {
        "surahNumber": 106,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لِإِيلَـٰفِ قُرَيْشٍ",
        "juzNumber": 30,
        "pageNumber": 602
      },
      {
        "surahNumber": 106,
        "ayahNumber": 2,
        "uthmaniText": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
        "juzNumber": 30,
        "pageNumber": 602
      },
      {
        "surahNumber": 106,
        "ayahNumber": 3,
        "uthmaniText": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ",
        "juzNumber": 30,
        "pageNumber": 602
      },
      {
        "surahNumber": 106,
        "ayahNumber": 4,
        "uthmaniText": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
        "juzNumber": 30,
        "pageNumber": 602
      }
