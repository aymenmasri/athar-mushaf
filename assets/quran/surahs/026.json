  "surah": {
    "number": 26,
    "arabicName": "الشعراء",
    "transliteratedName": "Ash-Shu'araa",
    "englishName": "The Poets",
    "revelationType": "makkah",
    "ayahCount": 227,
    "verses": [
      {
        "surahNumber": 26,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ طسٓمٓ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 2,
        "uthmaniText": "تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 3,
        "uthmaniText": "لَعَلَّكَ بَـٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 4,
        "uthmaniText": "إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَـٰقُهُمْ لَهَا خَـٰضِعِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 5,
        "uthmaniText": "وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَـٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 6,
        "uthmaniText": "فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 7,
        "uthmaniText": "أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 8,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 9,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 10,
        "uthmaniText": "وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 11,
        "uthmaniText": "قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 12,
        "uthmaniText": "قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 13,
        "uthmaniText": "وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَـٰرُونَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 14,
        "uthmaniText": "وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 15,
        "uthmaniText": "قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 16,
        "uthmaniText": "فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 17,
        "uthmaniText": "أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 18,
        "uthmaniText": "قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 19,
        "uthmaniText": "وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَـٰفِرِينَ",
        "juzNumber": 19,
        "pageNumber": 367
      },
      {
        "surahNumber": 26,
        "ayahNumber": 20,
        "uthmaniText": "قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 21,
        "uthmaniText": "فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 22,
        "uthmaniText": "وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 23,
        "uthmaniText": "قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 24,
        "uthmaniText": "قَالَ رَبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 25,
        "uthmaniText": "قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 26,
        "uthmaniText": "قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 27,
        "uthmaniText": "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 28,
        "uthmaniText": "قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُمْ تَعْقِلُونَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 29,
        "uthmaniText": "قَالَ لَئِنِ ٱتَّخَذْتَ إِلَـٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 30,
        "uthmaniText": "قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍ مُّبِينٍ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 31,
        "uthmaniText": "قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 32,
        "uthmaniText": "فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 33,
        "uthmaniText": "وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 34,
        "uthmaniText": "قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِيمٌ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 35,
        "uthmaniText": "يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 36,
        "uthmaniText": "قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 37,
        "uthmaniText": "يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 38,
        "uthmaniText": "فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 39,
        "uthmaniText": "وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ",
        "juzNumber": 19,
        "pageNumber": 368
      },
      {
        "surahNumber": 26,
        "ayahNumber": 40,
        "uthmaniText": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 41,
        "uthmaniText": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَـٰلِبِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 42,
        "uthmaniText": "قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 43,
        "uthmaniText": "قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 44,
        "uthmaniText": "فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَـٰلِبُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 45,
        "uthmaniText": "فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 46,
        "uthmaniText": "فَأُلْقِىَ ٱلسَّحَرَةُ سَـٰجِدِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 47,
        "uthmaniText": "قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 48,
        "uthmaniText": "رَبِّ مُوسَىٰ وَهَـٰرُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 49,
        "uthmaniText": "قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَـٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 50,
        "uthmaniText": "قَالُوا۟ لَا ضَيْرَ ۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 51,
        "uthmaniText": "إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَـٰيَـٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 52,
        "uthmaniText": "وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 53,
        "uthmaniText": "فَأَرْسَلَ فِرْعَوْنُ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 54,
        "uthmaniText": "إِنَّ هَـٰٓؤُلَآءِ لَشِرْذِمَةٌ قَلِيلُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 55,
        "uthmaniText": "وَإِنَّهُمْ لَنَا لَغَآئِظُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 56,
        "uthmaniText": "وَإِنَّا لَجَمِيعٌ حَـٰذِرُونَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 57,
        "uthmaniText": "فَأَخْرَجْنَـٰهُم مِّن جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 58,
        "uthmaniText": "وَكُنُوزٍ وَمَقَامٍ كَرِيمٍ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 59,
        "uthmaniText": "كَذَٰلِكَ وَأَوْرَثْنَـٰهَا بَنِىٓ إِسْرَٰٓءِيلَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 60,
        "uthmaniText": "فَأَتْبَعُوهُم مُّشْرِقِينَ",
        "juzNumber": 19,
        "pageNumber": 369
      },
      {
        "surahNumber": 26,
        "ayahNumber": 61,
        "uthmaniText": "فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَـٰبُ مُوسَىٰٓ إِنَّا لَمُدْرَكُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 62,
        "uthmaniText": "قَالَ كَلَّآ ۖ إِنَّ مَعِىَ رَبِّى سَيَهْدِينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 63,
        "uthmaniText": "فَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ ۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرْقٍ كَٱلطَّوْدِ ٱلْعَظِيمِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 64,
        "uthmaniText": "وَأَزْلَفْنَا ثَمَّ ٱلْـَٔاخَرِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 65,
        "uthmaniText": "وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 66,
        "uthmaniText": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 67,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 68,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 69,
        "uthmaniText": "وَٱتْلُ عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 70,
        "uthmaniText": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 71,
        "uthmaniText": "قَالُوا۟ نَعْبُدُ أَصْنَامًا فَنَظَلُّ لَهَا عَـٰكِفِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 72,
        "uthmaniText": "قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 73,
        "uthmaniText": "أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 74,
        "uthmaniText": "قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 75,
        "uthmaniText": "قَالَ أَفَرَءَيْتُم مَّا كُنتُمْ تَعْبُدُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 76,
        "uthmaniText": "أَنتُمْ وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 77,
        "uthmaniText": "فَإِنَّهُمْ عَدُوٌّ لِّىٓ إِلَّا رَبَّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 78,
        "uthmaniText": "ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 79,
        "uthmaniText": "وَٱلَّذِى هُوَ يُطْعِمُنِى وَيَسْقِينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 80,
        "uthmaniText": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 81,
        "uthmaniText": "وَٱلَّذِى يُمِيتُنِى ثُمَّ يُحْيِينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 82,
        "uthmaniText": "وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 83,
        "uthmaniText": "رَبِّ هَبْ لِى حُكْمًا وَأَلْحِقْنِى بِٱلصَّـٰلِحِينَ",
        "juzNumber": 19,
        "pageNumber": 370
      },
      {
        "surahNumber": 26,
        "ayahNumber": 84,
        "uthmaniText": "وَٱجْعَل لِّى لِسَانَ صِدْقٍ فِى ٱلْـَٔاخِرِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 85,
        "uthmaniText": "وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 86,
        "uthmaniText": "وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 87,
        "uthmaniText": "وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 88,
        "uthmaniText": "يَوْمَ لَا يَنفَعُ مَالٌ وَلَا بَنُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 89,
        "uthmaniText": "إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍ سَلِيمٍ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 90,
        "uthmaniText": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 91,
        "uthmaniText": "وَبُرِّزَتِ ٱلْجَحِيمُ لِلْغَاوِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 92,
        "uthmaniText": "وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 93,
        "uthmaniText": "مِن دُونِ ٱللَّهِ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 94,
        "uthmaniText": "فَكُبْكِبُوا۟ فِيهَا هُمْ وَٱلْغَاوُۥنَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 95,
        "uthmaniText": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 96,
        "uthmaniText": "قَالُوا۟ وَهُمْ فِيهَا يَخْتَصِمُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 97,
        "uthmaniText": "تَٱللَّهِ إِن كُنَّا لَفِى ضَلَـٰلٍ مُّبِينٍ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 98,
        "uthmaniText": "إِذْ نُسَوِّيكُم بِرَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 99,
        "uthmaniText": "وَمَآ أَضَلَّنَآ إِلَّا ٱلْمُجْرِمُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 100,
        "uthmaniText": "فَمَا لَنَا مِن شَـٰفِعِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 101,
        "uthmaniText": "وَلَا صَدِيقٍ حَمِيمٍ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 102,
        "uthmaniText": "فَلَوْ أَنَّ لَنَا كَرَّةً فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 103,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 104,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 105,
        "uthmaniText": "كَذَّبَتْ قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 106,
        "uthmaniText": "إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 107,
        "uthmaniText": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 108,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 109,
        "uthmaniText": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 110,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 111,
        "uthmaniText": "قَالُوٓا۟ أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ",
        "juzNumber": 19,
        "pageNumber": 371
      },
      {
        "surahNumber": 26,
        "ayahNumber": 112,
        "uthmaniText": "قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 113,
        "uthmaniText": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 114,
        "uthmaniText": "وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 115,
        "uthmaniText": "إِنْ أَنَا۠ إِلَّا نَذِيرٌ مُّبِينٌ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 116,
        "uthmaniText": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَـٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 117,
        "uthmaniText": "قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 118,
        "uthmaniText": "فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 119,
        "uthmaniText": "فَأَنجَيْنَـٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 120,
        "uthmaniText": "ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 121,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 122,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 123,
        "uthmaniText": "كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 124,
        "uthmaniText": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 125,
        "uthmaniText": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 126,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 127,
        "uthmaniText": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 128,
        "uthmaniText": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةً تَعْبَثُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 129,
        "uthmaniText": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 130,
        "uthmaniText": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 131,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 132,
        "uthmaniText": "وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 133,
        "uthmaniText": "أَمَدَّكُم بِأَنْعَـٰمٍ وَبَنِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 134,
        "uthmaniText": "وَجَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 135,
        "uthmaniText": "إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 136,
        "uthmaniText": "قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ",
        "juzNumber": 19,
        "pageNumber": 372
      },
      {
        "surahNumber": 26,
        "ayahNumber": 137,
        "uthmaniText": "إِنْ هَـٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 138,
        "uthmaniText": "وَمَا نَحْنُ بِمُعَذَّبِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 139,
        "uthmaniText": "فَكَذَّبُوهُ فَأَهْلَكْنَـٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 140,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 141,
        "uthmaniText": "كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 142,
        "uthmaniText": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَـٰلِحٌ أَلَا تَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 143,
        "uthmaniText": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 144,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 145,
        "uthmaniText": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 146,
        "uthmaniText": "أَتُتْرَكُونَ فِى مَا هَـٰهُنَآ ءَامِنِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 147,
        "uthmaniText": "فِى جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 148,
        "uthmaniText": "وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضِيمٌ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 149,
        "uthmaniText": "وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا فَـٰرِهِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 150,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 151,
        "uthmaniText": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 152,
        "uthmaniText": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 153,
        "uthmaniText": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 154,
        "uthmaniText": "مَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 155,
        "uthmaniText": "قَالَ هَـٰذِهِۦ نَاقَةٌ لَّهَا شِرْبٌ وَلَكُمْ شِرْبُ يَوْمٍ مَّعْلُومٍ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 156,
        "uthmaniText": "وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 157,
        "uthmaniText": "فَعَقَرُوهَا فَأَصْبَحُوا۟ نَـٰدِمِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 158,
        "uthmaniText": "فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 159,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 373
      },
      {
        "surahNumber": 26,
        "ayahNumber": 160,
        "uthmaniText": "كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 161,
        "uthmaniText": "إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 162,
        "uthmaniText": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 163,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 164,
        "uthmaniText": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 165,
        "uthmaniText": "أَتَأْتُونَ ٱلذُّكْرَانَ مِنَ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 166,
        "uthmaniText": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُم ۚ بَلْ أَنتُمْ قَوْمٌ عَادُونَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 167,
        "uthmaniText": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَـٰلُوطُ لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 168,
        "uthmaniText": "قَالَ إِنِّى لِعَمَلِكُم مِّنَ ٱلْقَالِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 169,
        "uthmaniText": "رَبِّ نَجِّنِى وَأَهْلِى مِمَّا يَعْمَلُونَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 170,
        "uthmaniText": "فَنَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 171,
        "uthmaniText": "إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 172,
        "uthmaniText": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 173,
        "uthmaniText": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًا ۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 174,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 175,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 176,
        "uthmaniText": "كَذَّبَ أَصْحَـٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 177,
        "uthmaniText": "إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 178,
        "uthmaniText": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 179,
        "uthmaniText": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 180,
        "uthmaniText": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 181,
        "uthmaniText": "أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 182,
        "uthmaniText": "وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 183,
        "uthmaniText": "وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ",
        "juzNumber": 19,
        "pageNumber": 374
      },
      {
        "surahNumber": 26,
        "ayahNumber": 184,
        "uthmaniText": "وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 185,
        "uthmaniText": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 186,
        "uthmaniText": "وَمَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَـٰذِبِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 187,
        "uthmaniText": "فَأَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 188,
        "uthmaniText": "قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 189,
        "uthmaniText": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 190,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 191,
        "uthmaniText": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 192,
        "uthmaniText": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 193,
        "uthmaniText": "نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 194,
        "uthmaniText": "عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 195,
        "uthmaniText": "بِلِسَانٍ عَرَبِىٍّ مُّبِينٍ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 196,
        "uthmaniText": "وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 197,
        "uthmaniText": "أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 198,
        "uthmaniText": "وَلَوْ نَزَّلْنَـٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 199,
        "uthmaniText": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 200,
        "uthmaniText": "كَذَٰلِكَ سَلَكْنَـٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 201,
        "uthmaniText": "لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 202,
        "uthmaniText": "فَيَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 203,
        "uthmaniText": "فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 204,
        "uthmaniText": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 205,
        "uthmaniText": "أَفَرَءَيْتَ إِن مَّتَّعْنَـٰهُمْ سِنِينَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 206,
        "uthmaniText": "ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ",
        "juzNumber": 19,
        "pageNumber": 375
      },
      {
        "surahNumber": 26,
        "ayahNumber": 207,
        "uthmaniText": "مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 208,
        "uthmaniText": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 209,
        "uthmaniText": "ذِكْرَىٰ وَمَا كُنَّا ظَـٰلِمِينَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 210,
        "uthmaniText": "وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَـٰطِينُ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 211,
        "uthmaniText": "وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 212,
        "uthmaniText": "إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 213,
        "uthmaniText": "فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 214,
        "uthmaniText": "وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 215,
        "uthmaniText": "وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 216,
        "uthmaniText": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌ مِّمَّا تَعْمَلُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 217,
        "uthmaniText": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 218,
        "uthmaniText": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 219,
        "uthmaniText": "وَتَقَلُّبَكَ فِى ٱلسَّـٰجِدِينَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 220,
        "uthmaniText": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 221,
        "uthmaniText": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 222,
        "uthmaniText": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 223,
        "uthmaniText": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 224,
        "uthmaniText": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 225,
        "uthmaniText": "أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍ يَهِيمُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 226,
        "uthmaniText": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      },
      {
        "surahNumber": 26,
        "ayahNumber": 227,
        "uthmaniText": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍ يَنقَلِبُونَ",
        "juzNumber": 19,
        "pageNumber": 376
      }
    ]
  }
}
