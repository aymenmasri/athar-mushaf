  "surah": {
    "number": 102,
    "arabicName": "التكاثر",
    "transliteratedName": "At-Takaathur",
    "englishName": "Competition",
    "revelationType": "makkah",
    "ayahCount": 8,
    "verses": [
      {
        "surahNumber": 102,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 2,
        "uthmaniText": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 3,
        "uthmaniText": "كَلَّا سَوْفَ تَعْلَمُونَ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 4,
        "uthmaniText": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 5,
        "uthmaniText": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 6,
        "uthmaniText": "لَتَرَوُنَّ ٱلْجَحِيمَ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 7,
        "uthmaniText": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 102,
        "ayahNumber": 8,
        "uthmaniText": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
        "juzNumber": 30,
        "pageNumber": 600
      }
    ]
  }
