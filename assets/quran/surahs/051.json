  "surah": {
    "number": 51,
    "arabicName": "الذاريات",
    "transliteratedName": "Adh-Dhaariyat",
    "englishName": "The Winnowing Winds",
    "revelationType": "makkah",
    "ayahCount": 60,
    "verses": [
      {
        "surahNumber": 51,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَـٰتِ ذَرْوًا",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 2,
        "uthmaniText": "فَٱلْحَـٰمِلَـٰتِ وِقْرًا",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 3,
        "uthmaniText": "فَٱلْجَـٰرِيَـٰتِ يُسْرًا",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 4,
        "uthmaniText": "فَٱلْمُقَسِّمَـٰتِ أَمْرًا",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 5,
        "uthmaniText": "إِنَّمَا تُوعَدُونَ لَصَادِقٌ",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 6,
        "uthmaniText": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌ",
        "juzNumber": 26,
        "pageNumber": 520
      },
      {
        "surahNumber": 51,
        "ayahNumber": 7,
        "uthmaniText": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 8,
        "uthmaniText": "إِنَّكُمْ لَفِى قَوْلٍ مُّخْتَلِفٍ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 9,
        "uthmaniText": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 10,
        "uthmaniText": "قُتِلَ ٱلْخَرَّٰصُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 11,
        "uthmaniText": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍ سَاهُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 12,
        "uthmaniText": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 13,
        "uthmaniText": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 14,
        "uthmaniText": "ذُوقُوا۟ فِتْنَتَكُمْ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 15,
        "uthmaniText": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 16,
        "uthmaniText": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 17,
        "uthmaniText": "كَانُوا۟ قَلِيلًا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 18,
        "uthmaniText": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 19,
        "uthmaniText": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّ لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 20,
        "uthmaniText": "وَفِى ٱلْأَرْضِ ءَايَـٰتٌ لِّلْمُوقِنِينَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 21,
        "uthmaniText": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 22,
        "uthmaniText": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 23,
        "uthmaniText": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 24,
        "uthmaniText": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 25,
        "uthmaniText": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا ۖ قَالَ سَلَـٰمٌ قَوْمٌ مُّنكَرُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 26,
        "uthmaniText": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍ سَمِينٍ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 27,
        "uthmaniText": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 28,
        "uthmaniText": "فَأَوْجَسَ مِنْهُمْ خِيفَةً ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَـٰمٍ عَلِيمٍ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 29,
        "uthmaniText": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 30,
        "uthmaniText": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ",
        "juzNumber": 26,
        "pageNumber": 521
      },
      {
        "surahNumber": 51,
        "ayahNumber": 31,
        "uthmaniText": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 32,
        "uthmaniText": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ مُّجْرِمِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 33,
        "uthmaniText": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِّن طِينٍ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 34,
        "uthmaniText": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 35,
        "uthmaniText": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 36,
        "uthmaniText": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍ مِّنَ ٱلْمُسْلِمِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 37,
        "uthmaniText": "وَتَرَكْنَا فِيهَآ ءَايَةً لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 38,
        "uthmaniText": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَـٰنٍ مُّبِينٍ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 39,
        "uthmaniText": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ أَوْ مَجْنُونٌ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 40,
        "uthmaniText": "فَأَخَذْنَـٰهُ وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 41,
        "uthmaniText": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 42,
        "uthmaniText": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 43,
        "uthmaniText": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 44,
        "uthmaniText": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 45,
        "uthmaniText": "فَمَا ٱسْتَطَـٰعُوا۟ مِن قِيَامٍ وَمَا كَانُوا۟ مُنتَصِرِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 46,
        "uthmaniText": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًا فَـٰسِقِينَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 47,
        "uthmaniText": "وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوسِعُونَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 48,
        "uthmaniText": "وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 49,
        "uthmaniText": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 50,
        "uthmaniText": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 51,
        "uthmaniText": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ",
        "juzNumber": 27,
        "pageNumber": 522
      },
      {
        "surahNumber": 51,
        "ayahNumber": 52,
        "uthmaniText": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 53,
        "uthmaniText": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌ طَاغُونَ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 54,
        "uthmaniText": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 55,
        "uthmaniText": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 56,
        "uthmaniText": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 57,
        "uthmaniText": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍ وَمَآ أُرِيدُ أَن يُطْعِمُونِ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 58,
        "uthmaniText": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 59,
        "uthmaniText": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًا مِّثْلَ ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا يَسْتَعْجِلُونِ",
        "juzNumber": 27,
        "pageNumber": 523
      },
      {
        "surahNumber": 51,
        "ayahNumber": 60,
        "uthmaniText": "فَوَيْلٌ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ",
        "juzNumber": 27,
        "pageNumber": 523
      }
    ]
  }
}
