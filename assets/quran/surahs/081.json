  "surah": {
    "number": 81,
    "arabicName": "التكوير",
    "transliteratedName": "At-Takwir",
    "englishName": "The Overthrowing",
    "revelationType": "makkah",
    "ayahCount": 29,
    "verses": [
      {
        "surahNumber": 81,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 2,
        "uthmaniText": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 3,
        "uthmaniText": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 4,
        "uthmaniText": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 5,
        "uthmaniText": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 6,
        "uthmaniText": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 7,
        "uthmaniText": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 8,
        "uthmaniText": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 9,
        "uthmaniText": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 10,
        "uthmaniText": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 11,
        "uthmaniText": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 12,
        "uthmaniText": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 13,
        "uthmaniText": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 14,
        "uthmaniText": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 15,
        "uthmaniText": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 16,
        "uthmaniText": "ٱلْجَوَارِ ٱلْكُنَّسِ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 17,
        "uthmaniText": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 18,
        "uthmaniText": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 19,
        "uthmaniText": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 20,
        "uthmaniText": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 21,
        "uthmaniText": "مُّطَاعٍ ثَمَّ أَمِينٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 22,
        "uthmaniText": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 23,
        "uthmaniText": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 24,
        "uthmaniText": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 25,
        "uthmaniText": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 26,
        "uthmaniText": "فَأَيْنَ تَذْهَبُونَ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 27,
        "uthmaniText": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 28,
        "uthmaniText": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
        "juzNumber": 30,
        "pageNumber": 586
      },
      {
        "surahNumber": 81,
        "ayahNumber": 29,
        "uthmaniText": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 30,
        "pageNumber": 586
      }
    ]
  }
}
