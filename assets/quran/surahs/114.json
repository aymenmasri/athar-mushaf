    "verses": [
      {
        "surahNumber": 114,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      },
      {
        "surahNumber": 114,
        "ayahNumber": 2,
        "uthmaniText": "مَلِكِ ٱلنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      },
      {
        "surahNumber": 114,
        "ayahNumber": 3,
        "uthmaniText": "إِلَـٰهِ ٱلنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      },
      {
        "surahNumber": 114,
        "ayahNumber": 4,
        "uthmaniText": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      },
      {
        "surahNumber": 114,
        "ayahNumber": 5,
        "uthmaniText": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      },
      {
        "surahNumber": 114,
        "ayahNumber": 6,
        "uthmaniText": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
        "juzNumber": 30,
        "pageNumber": 604
      }
    ]
  }
