  "surah": {
    "number": 56,
    "arabicName": "الواقعة",
    "transliteratedName": "Al-Waaqia",
    "englishName": "The Inevitable",
    "revelationType": "makkah",
    "ayahCount": 96,
    "verses": [
      {
        "surahNumber": 56,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 2,
        "uthmaniText": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 3,
        "uthmaniText": "خَافِضَةٌ رَّافِعَةٌ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 4,
        "uthmaniText": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 5,
        "uthmaniText": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 6,
        "uthmaniText": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 7,
        "uthmaniText": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 8,
        "uthmaniText": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 9,
        "uthmaniText": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 10,
        "uthmaniText": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 11,
        "uthmaniText": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 12,
        "uthmaniText": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 13,
        "uthmaniText": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 14,
        "uthmaniText": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 15,
        "uthmaniText": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 16,
        "uthmaniText": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ",
        "juzNumber": 27,
        "pageNumber": 534
      },
      {
        "surahNumber": 56,
        "ayahNumber": 17,
        "uthmaniText": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 18,
        "uthmaniText": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 19,
        "uthmaniText": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 20,
        "uthmaniText": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 21,
        "uthmaniText": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 22,
        "uthmaniText": "وَحُورٌ عِينٌ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 23,
        "uthmaniText": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 24,
        "uthmaniText": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 25,
        "uthmaniText": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 26,
        "uthmaniText": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 27,
        "uthmaniText": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 28,
        "uthmaniText": "فِى سِدْرٍ مَّخْضُودٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 29,
        "uthmaniText": "وَطَلْحٍ مَّنضُودٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 30,
        "uthmaniText": "وَظِلٍّ مَّمْدُودٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 31,
        "uthmaniText": "وَمَآءٍ مَّسْكُوبٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 32,
        "uthmaniText": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 33,
        "uthmaniText": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 34,
        "uthmaniText": "وَفُرُشٍ مَّرْفُوعَةٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 35,
        "uthmaniText": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 36,
        "uthmaniText": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 37,
        "uthmaniText": "عُرُبًا أَتْرَابًا",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 38,
        "uthmaniText": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 39,
        "uthmaniText": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 40,
        "uthmaniText": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 41,
        "uthmaniText": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 42,
        "uthmaniText": "فِى سَمُومٍ وَحَمِيمٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 43,
        "uthmaniText": "وَظِلٍّ مِّن يَحْمُومٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 44,
        "uthmaniText": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 45,
        "uthmaniText": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 46,
        "uthmaniText": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 47,
        "uthmaniText": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 48,
        "uthmaniText": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 49,
        "uthmaniText": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 50,
        "uthmaniText": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
        "juzNumber": 27,
        "pageNumber": 535
      },
      {
        "surahNumber": 56,
        "ayahNumber": 51,
        "uthmaniText": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 52,
        "uthmaniText": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 53,
        "uthmaniText": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 54,
        "uthmaniText": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 55,
        "uthmaniText": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 56,
        "uthmaniText": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 57,
        "uthmaniText": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 58,
        "uthmaniText": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 59,
        "uthmaniText": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 60,
        "uthmaniText": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 61,
        "uthmaniText": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 62,
        "uthmaniText": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 63,
        "uthmaniText": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 64,
        "uthmaniText": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 65,
        "uthmaniText": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 66,
        "uthmaniText": "إِنَّا لَمُغْرَمُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 67,
        "uthmaniText": "بَلْ نَحْنُ مَحْرُومُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 68,
        "uthmaniText": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 69,
        "uthmaniText": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 70,
        "uthmaniText": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 71,
        "uthmaniText": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 72,
        "uthmaniText": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 73,
        "uthmaniText": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 74,
        "uthmaniText": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 75,
        "uthmaniText": "فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 76,
        "uthmaniText": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
        "juzNumber": 27,
        "pageNumber": 536
      },
      {
        "surahNumber": 56,
        "ayahNumber": 77,
        "uthmaniText": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 78,
        "uthmaniText": "فِى كِتَـٰبٍ مَّكْنُونٍ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 79,
        "uthmaniText": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 80,
        "uthmaniText": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 81,
        "uthmaniText": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 82,
        "uthmaniText": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 83,
        "uthmaniText": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 84,
        "uthmaniText": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 85,
        "uthmaniText": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 86,
        "uthmaniText": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 87,
        "uthmaniText": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 88,
        "uthmaniText": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 89,
        "uthmaniText": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 90,
        "uthmaniText": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 91,
        "uthmaniText": "فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 92,
        "uthmaniText": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 93,
        "uthmaniText": "فَنُزُلٌ مِّنْ حَمِيمٍ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 94,
        "uthmaniText": "وَتَصْلِيَةُ جَحِيمٍ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 95,
        "uthmaniText": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ",
        "juzNumber": 27,
        "pageNumber": 537
      },
      {
        "surahNumber": 56,
        "ayahNumber": 96,
        "uthmaniText": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
        "juzNumber": 27,
        "pageNumber": 537
      }
    ]
  }
}
