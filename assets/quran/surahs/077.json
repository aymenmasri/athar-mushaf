  "surah": {
    "number": 77,
    "arabicName": "المرسلات",
    "transliteratedName": "Al-Mursalaat",
    "englishName": "The Emissaries",
    "revelationType": "makkah",
    "ayahCount": 50,
    "verses": [
      {
        "surahNumber": 77,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَـٰتِ عُرْفًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 2,
        "uthmaniText": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 3,
        "uthmaniText": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 4,
        "uthmaniText": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 5,
        "uthmaniText": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 6,
        "uthmaniText": "عُذْرًا أَوْ نُذْرًا",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 7,
        "uthmaniText": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 8,
        "uthmaniText": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 9,
        "uthmaniText": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 10,
        "uthmaniText": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 11,
        "uthmaniText": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 12,
        "uthmaniText": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 13,
        "uthmaniText": "لِيَوْمِ ٱلْفَصْلِ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 14,
        "uthmaniText": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 15,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 16,
        "uthmaniText": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 17,
        "uthmaniText": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 18,
        "uthmaniText": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 19,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 580
      },
      {
        "surahNumber": 77,
        "ayahNumber": 20,
        "uthmaniText": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 21,
        "uthmaniText": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 22,
        "uthmaniText": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 23,
        "uthmaniText": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 24,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 25,
        "uthmaniText": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 26,
        "uthmaniText": "أَحْيَآءً وَأَمْوَٰتًا",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 27,
        "uthmaniText": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 28,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 29,
        "uthmaniText": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 30,
        "uthmaniText": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 31,
        "uthmaniText": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 32,
        "uthmaniText": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 33,
        "uthmaniText": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 34,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 35,
        "uthmaniText": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 36,
        "uthmaniText": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 37,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 38,
        "uthmaniText": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 39,
        "uthmaniText": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 40,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 41,
        "uthmaniText": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 42,
        "uthmaniText": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 43,
        "uthmaniText": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 44,
        "uthmaniText": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 45,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 46,
        "uthmaniText": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 47,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 48,
        "uthmaniText": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 49,
        "uthmaniText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 581
      },
      {
        "surahNumber": 77,
        "ayahNumber": 50,
        "uthmaniText": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
        "juzNumber": 29,
        "pageNumber": 581
      }
    ]
  }
}
