      {
        "surahNumber": 103,
        "ayahNumber": 2,
        "uthmaniText": "إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ",
        "juzNumber": 30,
        "pageNumber": 601
      },
      {
        "surahNumber": 103,
        "ayahNumber": 3,
        "uthmaniText": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",
