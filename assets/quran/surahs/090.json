  "surah": {
    "number": 90,
    "arabicName": "البلد",
    "transliteratedName": "Al-Balad",
    "englishName": "The City",
    "revelationType": "makkah",
    "ayahCount": 20,
    "verses": [
      {
        "surahNumber": 90,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 2,
        "uthmaniText": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 3,
        "uthmaniText": "وَوَالِدٍ وَمَا وَلَدَ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 4,
        "uthmaniText": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 5,
        "uthmaniText": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 6,
        "uthmaniText": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 7,
        "uthmaniText": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 8,
        "uthmaniText": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 9,
        "uthmaniText": "وَلِسَانًا وَشَفَتَيْنِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 10,
        "uthmaniText": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 11,
        "uthmaniText": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 12,
        "uthmaniText": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 13,
        "uthmaniText": "فَكُّ رَقَبَةٍ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 14,
        "uthmaniText": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 15,
        "uthmaniText": "يَتِيمًا ذَا مَقْرَبَةٍ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 16,
        "uthmaniText": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 17,
        "uthmaniText": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 18,
        "uthmaniText": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 19,
        "uthmaniText": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 90,
        "ayahNumber": 20,
        "uthmaniText": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
        "juzNumber": 30,
        "pageNumber": 594
      }
    ]
  }
}
