  "surah": {
    "number": 15,
    "arabicName": "الحجر",
    "transliteratedName": "Al-Hijr",
    "englishName": "The Rock",
    "revelationType": "makkah",
    "ayahCount": 99,
    "verses": [
      {
        "surahNumber": 15,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ وَقُرْءَانٍ مُّبِينٍ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 2,
        "uthmaniText": "رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 3,
        "uthmaniText": "ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُ ۖ فَسَوْفَ يَعْلَمُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 4,
        "uthmaniText": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَّعْلُومٌ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 5,
        "uthmaniText": "مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 6,
        "uthmaniText": "وَقَالُوا۟ يَـٰٓأَيُّهَا ٱلَّذِى نُزِّلَ عَلَيْهِ ٱلذِّكْرُ إِنَّكَ لَمَجْنُونٌ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 7,
        "uthmaniText": "لَّوْ مَا تَأْتِينَا بِٱلْمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 8,
        "uthmaniText": "مَا نُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ إِلَّا بِٱلْحَقِّ وَمَا كَانُوٓا۟ إِذًا مُّنظَرِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 9,
        "uthmaniText": "إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 10,
        "uthmaniText": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِى شِيَعِ ٱلْأَوَّلِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 11,
        "uthmaniText": "وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 12,
        "uthmaniText": "كَذَٰلِكَ نَسْلُكُهُۥ فِى قُلُوبِ ٱلْمُجْرِمِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 13,
        "uthmaniText": "لَا يُؤْمِنُونَ بِهِۦ ۖ وَقَدْ خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 14,
        "uthmaniText": "وَلَوْ فَتَحْنَا عَلَيْهِم بَابًا مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ يَعْرُجُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 15,
        "uthmaniText": "لَقَالُوٓا۟ إِنَّمَا سُكِّرَتْ أَبْصَـٰرُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ",
        "juzNumber": 14,
        "pageNumber": 262
      },
      {
        "surahNumber": 15,
        "ayahNumber": 16,
        "uthmaniText": "وَلَقَدْ جَعَلْنَا فِى ٱلسَّمَآءِ بُرُوجًا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 17,
        "uthmaniText": "وَحَفِظْنَـٰهَا مِن كُلِّ شَيْطَـٰنٍ رَّجِيمٍ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 18,
        "uthmaniText": "إِلَّا مَنِ ٱسْتَرَقَ ٱلسَّمْعَ فَأَتْبَعَهُۥ شِهَابٌ مُّبِينٌ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 19,
        "uthmaniText": "وَٱلْأَرْضَ مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ شَىْءٍ مَّوْزُونٍ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 20,
        "uthmaniText": "وَجَعَلْنَا لَكُمْ فِيهَا مَعَـٰيِشَ وَمَن لَّسْتُمْ لَهُۥ بِرَٰزِقِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 21,
        "uthmaniText": "وَإِن مِّن شَىْءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٍ مَّعْلُومٍ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 22,
        "uthmaniText": "وَأَرْسَلْنَا ٱلرِّيَـٰحَ لَوَٰقِحَ فَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءً فَأَسْقَيْنَـٰكُمُوهُ وَمَآ أَنتُمْ لَهُۥ بِخَـٰزِنِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 23,
        "uthmaniText": "وَإِنَّا لَنَحْنُ نُحْىِۦ وَنُمِيتُ وَنَحْنُ ٱلْوَٰرِثُونَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 24,
        "uthmaniText": "وَلَقَدْ عَلِمْنَا ٱلْمُسْتَقْدِمِينَ مِنكُمْ وَلَقَدْ عَلِمْنَا ٱلْمُسْتَـْٔخِرِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 25,
        "uthmaniText": "وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ ۚ إِنَّهُۥ حَكِيمٌ عَلِيمٌ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 26,
        "uthmaniText": "وَلَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 27,
        "uthmaniText": "وَٱلْجَآنَّ خَلَقْنَـٰهُ مِن قَبْلُ مِن نَّارِ ٱلسَّمُومِ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 28,
        "uthmaniText": "وَإِذْ قَالَ رَبُّكَ لِلْمَلَـٰٓئِكَةِ إِنِّى خَـٰلِقٌۢ بَشَرًا مِّن صَلْصَـٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 29,
        "uthmaniText": "فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِى فَقَعُوا۟ لَهُۥ سَـٰجِدِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 30,
        "uthmaniText": "فَسَجَدَ ٱلْمَلَـٰٓئِكَةُ كُلُّهُمْ أَجْمَعُونَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 31,
        "uthmaniText": "إِلَّآ إِبْلِيسَ أَبَىٰٓ أَن يَكُونَ مَعَ ٱلسَّـٰجِدِينَ",
        "juzNumber": 14,
        "pageNumber": 263
      },
      {
        "surahNumber": 15,
        "ayahNumber": 32,
        "uthmaniText": "قَالَ يَـٰٓإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّـٰجِدِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 33,
        "uthmaniText": "قَالَ لَمْ أَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُۥ مِن صَلْصَـٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 34,
        "uthmaniText": "قَالَ فَٱخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 35,
        "uthmaniText": "وَإِنَّ عَلَيْكَ ٱللَّعْنَةَ إِلَىٰ يَوْمِ ٱلدِّينِ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 36,
        "uthmaniText": "قَالَ رَبِّ فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 37,
        "uthmaniText": "قَالَ فَإِنَّكَ مِنَ ٱلْمُنظَرِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 38,
        "uthmaniText": "إِلَىٰ يَوْمِ ٱلْوَقْتِ ٱلْمَعْلُومِ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 39,
        "uthmaniText": "قَالَ رَبِّ بِمَآ أَغْوَيْتَنِى لَأُزَيِّنَنَّ لَهُمْ فِى ٱلْأَرْضِ وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 40,
        "uthmaniText": "إِلَّا عِبَادَكَ مِنْهُمُ ٱلْمُخْلَصِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 41,
        "uthmaniText": "قَالَ هَـٰذَا صِرَٰطٌ عَلَىَّ مُسْتَقِيمٌ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 42,
        "uthmaniText": "إِنَّ عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْطَـٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلْغَاوِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 43,
        "uthmaniText": "وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 44,
        "uthmaniText": "لَهَا سَبْعَةُ أَبْوَٰبٍ لِّكُلِّ بَابٍ مِّنْهُمْ جُزْءٌ مَّقْسُومٌ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 45,
        "uthmaniText": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 46,
        "uthmaniText": "ٱدْخُلُوهَا بِسَلَـٰمٍ ءَامِنِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 47,
        "uthmaniText": "وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ إِخْوَٰنًا عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 48,
        "uthmaniText": "لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 49,
        "uthmaniText": "نَبِّئْ عِبَادِىٓ أَنِّىٓ أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 50,
        "uthmaniText": "وَأَنَّ عَذَابِى هُوَ ٱلْعَذَابُ ٱلْأَلِيمُ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 51,
        "uthmaniText": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ",
        "juzNumber": 14,
        "pageNumber": 264
      },
      {
        "surahNumber": 15,
        "ayahNumber": 52,
        "uthmaniText": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا قَالَ إِنَّا مِنكُمْ وَجِلُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 53,
        "uthmaniText": "قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ عَلِيمٍ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 54,
        "uthmaniText": "قَالَ أَبَشَّرْتُمُونِى عَلَىٰٓ أَن مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 55,
        "uthmaniText": "قَالُوا۟ بَشَّرْنَـٰكَ بِٱلْحَقِّ فَلَا تَكُن مِّنَ ٱلْقَـٰنِطِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 56,
        "uthmaniText": "قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 57,
        "uthmaniText": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 58,
        "uthmaniText": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ مُّجْرِمِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 59,
        "uthmaniText": "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 60,
        "uthmaniText": "إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ ٱلْغَـٰبِرِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 61,
        "uthmaniText": "فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 62,
        "uthmaniText": "قَالَ إِنَّكُمْ قَوْمٌ مُّنكَرُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 63,
        "uthmaniText": "قَالُوا۟ بَلْ جِئْنَـٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 64,
        "uthmaniText": "وَأَتَيْنَـٰكَ بِٱلْحَقِّ وَإِنَّا لَصَـٰدِقُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 65,
        "uthmaniText": "فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 66,
        "uthmaniText": "وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌ مُّصْبِحِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 67,
        "uthmaniText": "وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 68,
        "uthmaniText": "قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 69,
        "uthmaniText": "وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 70,
        "uthmaniText": "قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَـٰلَمِينَ",
        "juzNumber": 14,
        "pageNumber": 265
      },
      {
        "surahNumber": 15,
        "ayahNumber": 71,
        "uthmaniText": "قَالَ هَـٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَـٰعِلِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 72,
        "uthmaniText": "لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 73,
        "uthmaniText": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 74,
        "uthmaniText": "فَجَعَلْنَا عَـٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِّن سِجِّيلٍ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 75,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّلْمُتَوَسِّمِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 76,
        "uthmaniText": "وَإِنَّهَا لَبِسَبِيلٍ مُّقِيمٍ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 77,
        "uthmaniText": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً لِّلْمُؤْمِنِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 78,
        "uthmaniText": "وَإِن كَانَ أَصْحَـٰبُ ٱلْأَيْكَةِ لَظَـٰلِمِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 79,
        "uthmaniText": "فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 80,
        "uthmaniText": "وَلَقَدْ كَذَّبَ أَصْحَـٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 81,
        "uthmaniText": "وَءَاتَيْنَـٰهُمْ ءَايَـٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 82,
        "uthmaniText": "وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 83,
        "uthmaniText": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 84,
        "uthmaniText": "فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 85,
        "uthmaniText": "وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌ ۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 86,
        "uthmaniText": "إِنَّ رَبَّكَ هُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 87,
        "uthmaniText": "وَلَقَدْ ءَاتَيْنَـٰكَ سَبْعًا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 88,
        "uthmaniText": "لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 89,
        "uthmaniText": "وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 90,
        "uthmaniText": "كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ",
        "juzNumber": 14,
        "pageNumber": 266
      },
      {
        "surahNumber": 15,
        "ayahNumber": 91,
        "uthmaniText": "ٱلَّذِينَ جَعَلُوا۟ ٱلْقُرْءَانَ عِضِينَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 92,
        "uthmaniText": "فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ أَجْمَعِينَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 93,
        "uthmaniText": "عَمَّا كَانُوا۟ يَعْمَلُونَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 94,
        "uthmaniText": "فَٱصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 95,
        "uthmaniText": "إِنَّا كَفَيْنَـٰكَ ٱلْمُسْتَهْزِءِينَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 96,
        "uthmaniText": "ٱلَّذِينَ يَجْعَلُونَ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۚ فَسَوْفَ يَعْلَمُونَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 97,
        "uthmaniText": "وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 98,
        "uthmaniText": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ ٱلسَّـٰجِدِينَ",
        "juzNumber": 14,
        "pageNumber": 267
      },
      {
        "surahNumber": 15,
        "ayahNumber": 99,
        "uthmaniText": "وَٱعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ ٱلْيَقِينُ",
        "juzNumber": 14,
        "pageNumber": 267
      }
    ]
  }
}
