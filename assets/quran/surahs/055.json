        "pageNumber": 531
      },
      {
        "surahNumber": 55,
        "ayahNumber": 9,
        "uthmaniText": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
