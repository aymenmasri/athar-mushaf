        "pageNumber": 531
      },
      {
        "surahNumber": 55,
        "ayahNumber": 5,
        "uthmaniText": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
        "juzNumber": 27,
        "pageNumber": 531
      },
      {
        "surahNumber": 55,
        "ayahNumber": 6,
        "uthmaniText": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
        "juzNumber": 27,
        "pageNumber": 531
      },
      {
        "surahNumber": 55,
        "ayahNumber": 7,
        "uthmaniText": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
