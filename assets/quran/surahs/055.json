        "juzNumber": 27,
        "pageNumber": 531
      },
      {
        "surahNumber": 55,
        "ayahNumber": 15,
        "uthmaniText": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
