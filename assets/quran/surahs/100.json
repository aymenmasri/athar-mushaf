  "surah": {
    "number": 100,
    "arabicName": "العاديات",
    "transliteratedName": "Al-Aadiyaat",
    "englishName": "The Chargers",
    "revelationType": "makkah",
    "ayahCount": 11,
    "verses": [
      {
        "surahNumber": 100,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 2,
        "uthmaniText": "فَٱلْمُورِيَـٰتِ قَدْحًا",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 3,
        "uthmaniText": "فَٱلْمُغِيرَٰتِ صُبْحًا",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 4,
        "uthmaniText": "فَأَثَرْنَ بِهِۦ نَقْعًا",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 5,
        "uthmaniText": "فَوَسَطْنَ بِهِۦ جَمْعًا",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 6,
        "uthmaniText": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 7,
        "uthmaniText": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 8,
        "uthmaniText": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 9,
        "uthmaniText": "أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
        "juzNumber": 30,
        "pageNumber": 599
      },
      {
        "surahNumber": 100,
        "ayahNumber": 10,
        "uthmaniText": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
        "juzNumber": 30,
        "pageNumber": 600
      },
      {
        "surahNumber": 100,
        "ayahNumber": 11,
        "uthmaniText": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
        "juzNumber": 30,
        "pageNumber": 600
      }
    ]
  }
}
