  "surah": {
    "number": 95,
    "arabicName": "التين",
    "transliteratedName": "At-Tin",
    "englishName": "The Fig",
    "revelationType": "makkah",
    "ayahCount": 8,
    "verses": [
      {
        "surahNumber": 95,
        "ayahNumber": 1,
        "uthmaniText": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 2,
        "uthmaniText": "وَطُورِ سِينِينَ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 3,
        "uthmaniText": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 4,
        "uthmaniText": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 5,
        "uthmaniText": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 6,
        "uthmaniText": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 7,
        "uthmaniText": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
        "juzNumber": 30,
        "pageNumber": 597
      },
      {
        "surahNumber": 95,
        "ayahNumber": 8,
        "uthmaniText": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
        "juzNumber": 30,
        "pageNumber": 597
      }
    ]
  }
}
