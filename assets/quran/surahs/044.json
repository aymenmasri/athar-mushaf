  "surah": {
    "number": 44,
    "arabicName": "الدخان",
    "transliteratedName": "Ad-Dukhaan",
    "englishName": "The Smoke",
    "revelationType": "makkah",
    "ayahCount": 59,
    "verses": [
      {
        "surahNumber": 44,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ حمٓ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 2,
        "uthmaniText": "وَٱلْكِتَـٰبِ ٱلْمُبِينِ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 3,
        "uthmaniText": "إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةٍ مُّبَـٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 4,
        "uthmaniText": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 5,
        "uthmaniText": "أَمْرًا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 6,
        "uthmaniText": "رَحْمَةً مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 7,
        "uthmaniText": "رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 8,
        "uthmaniText": "لَآ إِلَـٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 9,
        "uthmaniText": "بَلْ هُمْ فِى شَكٍّ يَلْعَبُونَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 10,
        "uthmaniText": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍ مُّبِينٍ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 11,
        "uthmaniText": "يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ أَلِيمٌ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 12,
        "uthmaniText": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 13,
        "uthmaniText": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 14,
        "uthmaniText": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 15,
        "uthmaniText": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 16,
        "uthmaniText": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 17,
        "uthmaniText": "وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌ كَرِيمٌ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 18,
        "uthmaniText": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
        "juzNumber": 25,
        "pageNumber": 496
      },
      {
        "surahNumber": 44,
        "ayahNumber": 19,
        "uthmaniText": "وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍ مُّبِينٍ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 20,
        "uthmaniText": "وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 21,
        "uthmaniText": "وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 22,
        "uthmaniText": "فَدَعَا رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ قَوْمٌ مُّجْرِمُونَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 23,
        "uthmaniText": "فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 24,
        "uthmaniText": "وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌ مُّغْرَقُونَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 25,
        "uthmaniText": "كَمْ تَرَكُوا۟ مِن جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 26,
        "uthmaniText": "وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 27,
        "uthmaniText": "وَنَعْمَةٍ كَانُوا۟ فِيهَا فَـٰكِهِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 28,
        "uthmaniText": "كَذَٰلِكَ ۖ وَأَوْرَثْنَـٰهَا قَوْمًا ءَاخَرِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 29,
        "uthmaniText": "فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 30,
        "uthmaniText": "وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 31,
        "uthmaniText": "مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًا مِّنَ ٱلْمُسْرِفِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 32,
        "uthmaniText": "وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 33,
        "uthmaniText": "وَءَاتَيْنَـٰهُم مِّنَ ٱلْـَٔايَـٰتِ مَا فِيهِ بَلَـٰٓؤٌا۟ مُّبِينٌ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 34,
        "uthmaniText": "إِنَّ هَـٰٓؤُلَآءِ لَيَقُولُونَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 35,
        "uthmaniText": "إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 36,
        "uthmaniText": "فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَـٰدِقِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 37,
        "uthmaniText": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَـٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 38,
        "uthmaniText": "وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَـٰعِبِينَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 39,
        "uthmaniText": "مَا خَلَقْنَـٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ",
        "juzNumber": 25,
        "pageNumber": 497
      },
      {
        "surahNumber": 44,
        "ayahNumber": 40,
        "uthmaniText": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 41,
        "uthmaniText": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 42,
        "uthmaniText": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 43,
        "uthmaniText": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 44,
        "uthmaniText": "طَعَامُ ٱلْأَثِيمِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 45,
        "uthmaniText": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 46,
        "uthmaniText": "كَغَلْىِ ٱلْحَمِيمِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 47,
        "uthmaniText": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 48,
        "uthmaniText": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 49,
        "uthmaniText": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 50,
        "uthmaniText": "إِنَّ هَـٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 51,
        "uthmaniText": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 52,
        "uthmaniText": "فِى جَنَّـٰتٍ وَعُيُونٍ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 53,
        "uthmaniText": "يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 54,
        "uthmaniText": "كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 55,
        "uthmaniText": "يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 56,
        "uthmaniText": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 57,
        "uthmaniText": "فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 58,
        "uthmaniText": "فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ",
        "juzNumber": 25,
        "pageNumber": 498
      },
      {
        "surahNumber": 44,
        "ayahNumber": 59,
        "uthmaniText": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ",
        "juzNumber": 25,
        "pageNumber": 498
      }
    ]
  }
}
