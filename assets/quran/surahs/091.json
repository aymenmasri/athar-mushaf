  "surah": {
    "number": 91,
    "arabicName": "الشمس",
    "transliteratedName": "Ash-Shams",
    "englishName": "The Sun",
    "revelationType": "makkah",
    "ayahCount": 15,
    "verses": [
      {
        "surahNumber": 91,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 2,
        "uthmaniText": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 3,
        "uthmaniText": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 4,
        "uthmaniText": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 5,
        "uthmaniText": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 6,
        "uthmaniText": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 7,
        "uthmaniText": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 8,
        "uthmaniText": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 9,
        "uthmaniText": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 10,
        "uthmaniText": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 11,
        "uthmaniText": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 12,
        "uthmaniText": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 13,
        "uthmaniText": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 14,
        "uthmaniText": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      },
      {
        "surahNumber": 91,
        "ayahNumber": 15,
        "uthmaniText": "وَلَا يَخَافُ عُقْبَـٰهَا",
        "juzNumber": 30,
        "pageNumber": 595
      }
    ]
  }
}
