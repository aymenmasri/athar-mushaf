  "surah": {
    "number": 89,
    "arabicName": "الفجر",
    "transliteratedName": "Al-Fajr",
    "englishName": "The Dawn",
    "revelationType": "makkah",
    "ayahCount": 30,
    "verses": [
      {
        "surahNumber": 89,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 2,
        "uthmaniText": "وَلَيَالٍ عَشْرٍ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 3,
        "uthmaniText": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 4,
        "uthmaniText": "وَٱلَّيْلِ إِذَا يَسْرِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 5,
        "uthmaniText": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 6,
        "uthmaniText": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 7,
        "uthmaniText": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 8,
        "uthmaniText": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 9,
        "uthmaniText": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 10,
        "uthmaniText": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 11,
        "uthmaniText": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 12,
        "uthmaniText": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 13,
        "uthmaniText": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 14,
        "uthmaniText": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 15,
        "uthmaniText": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 16,
        "uthmaniText": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 17,
        "uthmaniText": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 18,
        "uthmaniText": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 19,
        "uthmaniText": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 20,
        "uthmaniText": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 21,
        "uthmaniText": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 22,
        "uthmaniText": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 23,
        "uthmaniText": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
        "juzNumber": 30,
        "pageNumber": 593
      },
      {
        "surahNumber": 89,
        "ayahNumber": 24,
        "uthmaniText": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 25,
        "uthmaniText": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 26,
        "uthmaniText": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 27,
        "uthmaniText": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 28,
        "uthmaniText": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 29,
        "uthmaniText": "فَٱدْخُلِى فِى عِبَـٰدِى",
        "juzNumber": 30,
        "pageNumber": 594
      },
      {
        "surahNumber": 89,
        "ayahNumber": 30,
        "uthmaniText": "وَٱدْخُلِى جَنَّتِى",
        "juzNumber": 30,
        "pageNumber": 594
      }
    ]
  }
}
