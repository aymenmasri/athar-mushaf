  "surah": {
    "number": 68,
    "arabicName": "القلم",
    "transliteratedName": "Al-Qalam",
    "englishName": "The Pen",
    "revelationType": "makkah",
    "ayahCount": 52,
    "verses": [
      {
        "surahNumber": 68,
        "ayahNumber": 1,
        "uthmaniText": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 2,
        "uthmaniText": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 3,
        "uthmaniText": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 4,
        "uthmaniText": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 5,
        "uthmaniText": "فَسَتُبْصِرُ وَيُبْصِرُونَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 6,
        "uthmaniText": "بِأَييِّكُمُ ٱلْمَفْتُونُ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 7,
        "uthmaniText": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 8,
        "uthmaniText": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 9,
        "uthmaniText": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 10,
        "uthmaniText": "وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 11,
        "uthmaniText": "هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 12,
        "uthmaniText": "مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 13,
        "uthmaniText": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 14,
        "uthmaniText": "أَن كَانَ ذَا مَالٍ وَبَنِينَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 15,
        "uthmaniText": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
        "juzNumber": 29,
        "pageNumber": 564
      },
      {
        "surahNumber": 68,
        "ayahNumber": 16,
        "uthmaniText": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 17,
        "uthmaniText": "إِنَّا بَلَوْنَـٰهُمْ كَمَا بَلَوْنَآ أَصْحَـٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 18,
        "uthmaniText": "وَلَا يَسْتَثْنُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 19,
        "uthmaniText": "فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 20,
        "uthmaniText": "فَأَصْبَحَتْ كَٱلصَّرِيمِ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 21,
        "uthmaniText": "فَتَنَادَوْا۟ مُصْبِحِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 22,
        "uthmaniText": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَـٰرِمِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 23,
        "uthmaniText": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَـٰفَتُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 24,
        "uthmaniText": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 25,
        "uthmaniText": "وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَـٰدِرِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 26,
        "uthmaniText": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 27,
        "uthmaniText": "بَلْ نَحْنُ مَحْرُومُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 28,
        "uthmaniText": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 29,
        "uthmaniText": "قَالُوا۟ سُبْحَـٰنَ رَبِّنَآ إِنَّا كُنَّا ظَـٰلِمِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 30,
        "uthmaniText": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَـٰوَمُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 31,
        "uthmaniText": "قَالُوا۟ يَـٰوَيْلَنَآ إِنَّا كُنَّا طَـٰغِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 32,
        "uthmaniText": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 33,
        "uthmaniText": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 34,
        "uthmaniText": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 35,
        "uthmaniText": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 36,
        "uthmaniText": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 37,
        "uthmaniText": "أَمْ لَكُمْ كِتَـٰبٌ فِيهِ تَدْرُسُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 38,
        "uthmaniText": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 39,
        "uthmaniText": "أَمْ لَكُمْ أَيْمَـٰنٌ عَلَيْنَا بَـٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 40,
        "uthmaniText": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 41,
        "uthmaniText": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَـٰدِقِينَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 42,
        "uthmaniText": "يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ",
        "juzNumber": 29,
        "pageNumber": 565
      },
      {
        "surahNumber": 68,
        "ayahNumber": 43,
        "uthmaniText": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَـٰلِمُونَ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 44,
        "uthmaniText": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 45,
        "uthmaniText": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 46,
        "uthmaniText": "أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 47,
        "uthmaniText": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 48,
        "uthmaniText": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 49,
        "uthmaniText": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 50,
        "uthmaniText": "فَٱجْتَبَـٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 51,
        "uthmaniText": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ",
        "juzNumber": 29,
        "pageNumber": 566
      },
      {
        "surahNumber": 68,
        "ayahNumber": 52,
        "uthmaniText": "وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
        "juzNumber": 29,
        "pageNumber": 566
      }
    ]
  }
}
