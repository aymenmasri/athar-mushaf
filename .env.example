# Variables publiques incorporées au bundle Expo.
# Laisser les deux valeurs vides pour démarrer automatiquement en mode démonstration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Facultatif sur Android/iOS : origine Web publique utilisée pour les liens partagés.
# Exemple après déploiement : https://athar-mushaf.expo.app
EXPO_PUBLIC_APP_URL=

# INTERDIT ICI ET DANS TOUT CODE CLIENT : service_role, secret key, JWT ou mot de passe.
