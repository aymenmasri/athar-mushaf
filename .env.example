# Variables publiques incorporées au bundle Expo : elles sont lisibles par les utilisateurs.
# Laisser les deux valeurs Supabase vides pour démarrer automatiquement en mode démonstration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origine Web HTTPS canonique, sans chemin, requise pour partager un vrai lien depuis Android/iOS.
# Exemple après déploiement : https://athar-mushaf.expo.app
EXPO_PUBLIC_APP_URL=

# INTERDIT ICI ET DANS TOUT CODE CLIENT : service_role, secret key, JWT ou mot de passe.
